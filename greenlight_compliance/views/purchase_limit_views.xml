<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_limit_tree" model="ir.ui.view">
        <field name="name">greenlight.purchase.limit.tree</field>
        <field name="model">greenlight.purchase.limit</field>
        <field name="arch" type="xml">
            <list>
                <field name="purchase_date"/>
                <field name="customer_id"/>
                <field name="transaction_id"/>
                <field name="product_type"/>
                <field name="weight_grams"/>
                <field name="mmceu_units"/>
                <field name="reset_at"/>
                <field name="voided"/>
            </list>
        </field>
    </record>

    <record id="action_purchase_limits" model="ir.actions.act_window">
        <field name="name">Purchase Limits</field>
        <field name="res_model">greenlight.purchase.limit</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
