<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_promotion_form" model="ir.ui.view">
        <field name="name">greenlight.promotion.form</field>
        <field name="model">greenlight.promotion</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            invisible="is_active" class="oe_highlight"/>
                    <button name="action_deactivate" type="object" string="Deactivate"
                            invisible="not is_active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Promotion Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Discount">
                            <field name="discount_type"/>
                            <field name="discount_value"/>
                            <field name="is_active"/>
                            <field name="display_on_pos"/>
                        </group>
                        <group string="Scope">
                            <field name="product_id"/>
                            <field name="category_id"/>
                            <field name="scope_display"/>
                        </group>
                    </group>
                    <group>
                        <group string="Schedule">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="is_expired"/>
                        </group>
                        <group string="Usage Limits">
                            <field name="max_uses"/>
                            <field name="current_uses"/>
                            <field name="is_maxed"/>
                            <field name="is_usable"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Promotion description for customers..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_promotion_tree" model="ir.ui.view">
        <field name="name">greenlight.promotion.tree</field>
        <field name="model">greenlight.promotion</field>
        <field name="arch" type="xml">
            <list decoration-success="is_usable"
                  decoration-muted="not is_active or is_expired">
                <field name="name"/>
                <field name="discount_type"/>
                <field name="discount_value"/>
                <field name="scope_display" string="Applies To"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="current_uses"/>
                <field name="max_uses"/>
                <field name="display_on_pos"/>
                <field name="is_usable"/>
                <field name="is_active" column_invisible="True"/>
                <field name="is_expired" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_promotion_search" model="ir.ui.view">
        <field name="name">greenlight.promotion.search</field>
        <field name="model">greenlight.promotion</field>
        <field name="arch" type="xml">
            <search>
                <filter name="active" string="Active"
                        domain="[('is_active', '=', True)]"/>
                <filter name="usable" string="Currently Usable"
                        domain="[('is_usable', '=', True)]"/>
                <filter name="pos_visible" string="Shown on POS"
                        domain="[('display_on_pos', '=', True)]"/>
                <separator/>
                <filter name="group_type" string="Discount Type"
                        context="{'group_by': 'discount_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_promotion" model="ir.actions.act_window">
        <field name="name">Promotions</field>
        <field name="res_model">greenlight.promotion</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
