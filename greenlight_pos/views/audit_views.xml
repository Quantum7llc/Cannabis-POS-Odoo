<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== AUDIT LOG ==================== -->

    <!-- Audit Log List View -->
    <record id="view_audit_log_tree" model="ir.ui.view">
        <field name="name">greenlight.audit.log.tree</field>
        <field name="model">greenlight.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="is_phi_access">
                <field name="create_date" string="Timestamp"/>
                <field name="action"/>
                <field name="resource_type"/>
                <field name="resource_name"/>
                <field name="resource_id"/>
                <field name="employee_id"/>
                <field name="ip_address"/>
                <field name="is_phi_access"/>
            </list>
        </field>
    </record>

    <!-- Audit Log Form View (read-only detail) -->
    <record id="view_audit_log_form" model="ir.ui.view">
        <field name="name">greenlight.audit.log.form</field>
        <field name="model">greenlight.audit.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>Audit Log Entry</h1>
                    </div>
                    <group>
                        <group string="Action">
                            <field name="action"/>
                            <field name="resource_type"/>
                            <field name="resource_name"/>
                            <field name="resource_id"/>
                            <field name="create_date" string="Timestamp"/>
                        </group>
                        <group string="Actor">
                            <field name="employee_id"/>
                            <field name="ip_address"/>
                            <field name="is_phi_access"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="details" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Audit Log Search View -->
    <record id="view_audit_log_search" model="ir.ui.view">
        <field name="name">greenlight.audit.log.search</field>
        <field name="model">greenlight.audit.log</field>
        <field name="arch" type="xml">
            <search string="Audit Logs">
                <field name="action"/>
                <field name="resource_type"/>
                <field name="resource_name"/>
                <field name="employee_id"/>
                <filter name="filter_phi" string="PHI Access" domain="[('is_phi_access', '=', True)]"/>
                <filter name="filter_today" string="Today"
                        domain="[('create_date', '&gt;=', (context_today()).strftime('%%Y-%%m-%%d'))]"/>
                <filter name="filter_this_week" string="This Week"
                        domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%%Y-%%m-%%d'))]"/>
                <separator/>
                <filter name="group_action" string="Action" context="{'group_by': 'action'}"/>
                <filter name="group_resource" string="Resource Type" context="{'group_by': 'resource_type'}"/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_date" string="Date" context="{'group_by': 'create_date:day'}"/>
            </search>
        </field>
    </record>

    <!-- Audit Log Action -->
    <record id="action_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">greenlight.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_audit_log_search"/>
        <field name="context">{'search_default_filter_today': 1}</field>
    </record>

    <!-- ==================== CHANGE LOG ==================== -->

    <!-- Change Log List View -->
    <record id="view_change_log_tree" model="ir.ui.view">
        <field name="name">greenlight.change.log.tree</field>
        <field name="model">greenlight.change.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date" string="Changed At"/>
                <field name="table_name"/>
                <field name="record_name"/>
                <field name="record_id"/>
                <field name="field_name"/>
                <field name="old_value"/>
                <field name="new_value"/>
                <field name="changed_by"/>
            </list>
        </field>
    </record>

    <!-- Change Log Form View -->
    <record id="view_change_log_form" model="ir.ui.view">
        <field name="name">greenlight.change.log.form</field>
        <field name="model">greenlight.change.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name_computed" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Record">
                            <field name="table_name"/>
                            <field name="record_name"/>
                            <field name="record_id"/>
                            <field name="field_name"/>
                        </group>
                        <group string="Change">
                            <field name="old_value"/>
                            <field name="new_value"/>
                            <field name="changed_by"/>
                            <field name="create_date" string="Changed At"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Change Log Search View -->
    <record id="view_change_log_search" model="ir.ui.view">
        <field name="name">greenlight.change.log.search</field>
        <field name="model">greenlight.change.log</field>
        <field name="arch" type="xml">
            <search string="Change Logs">
                <field name="table_name"/>
                <field name="record_name"/>
                <field name="field_name"/>
                <field name="changed_by"/>
                <filter name="filter_today" string="Today"
                        domain="[('create_date', '&gt;=', (context_today()).strftime('%%Y-%%m-%%d'))]"/>
                <separator/>
                <filter name="group_model" string="Model" context="{'group_by': 'table_name'}"/>
                <filter name="group_field" string="Field" context="{'group_by': 'field_name'}"/>
                <filter name="group_user" string="Changed By" context="{'group_by': 'changed_by'}"/>
                <filter name="group_date" string="Date" context="{'group_by': 'create_date:day'}"/>
            </search>
        </field>
    </record>

    <!-- Change Log Action -->
    <record id="action_change_log" model="ir.actions.act_window">
        <field name="name">Change Log</field>
        <field name="res_model">greenlight.change.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_change_log_search"/>
    </record>
</odoo>
