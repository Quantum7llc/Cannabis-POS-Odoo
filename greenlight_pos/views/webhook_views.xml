<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Webhook Configuration -->
    <record id="view_webhook_form" model="ir.ui.view">
        <field name="name">greenlight.webhook.form</field>
        <field name="model">greenlight.webhook</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g., Metrc Sync Webhook"/></h1>
                    </div>
                    <group>
                        <group string="Endpoint">
                            <field name="url" widget="url"/>
                            <field name="secret" password="True"/>
                            <field name="is_active"/>
                        </group>
                        <group string="Events">
                            <field name="event_types" widget="text"
                                   placeholder='["sale.created", "inventory.adjusted"]'/>
                        </group>
                    </group>
                    <group>
                        <group string="Statistics">
                            <field name="delivery_count" readonly="1"/>
                            <field name="last_delivery_at" readonly="1"/>
                            <field name="last_success" readonly="1"
                                   decoration-success="last_success"
                                   decoration-danger="not last_success"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Delivery Log" name="deliveries">
                            <field name="delivery_ids" readonly="1">
                                <list>
                                    <field name="create_date" string="Sent At"/>
                                    <field name="event_type"/>
                                    <field name="response_status"/>
                                    <field name="success"
                                           decoration-success="success"
                                           decoration-danger="not success"/>
                                    <field name="duration_ms"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_webhook_list" model="ir.ui.view">
        <field name="name">greenlight.webhook.list</field>
        <field name="model">greenlight.webhook</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="url"/>
                <field name="is_active"/>
                <field name="delivery_count"/>
                <field name="last_delivery_at"/>
                <field name="last_success"
                       decoration-success="last_success"
                       decoration-danger="not last_success"/>
            </list>
        </field>
    </record>

    <record id="view_webhook_search" model="ir.ui.view">
        <field name="name">greenlight.webhook.search</field>
        <field name="model">greenlight.webhook</field>
        <field name="arch" type="xml">
            <search>
                <filter string="Active" name="active" domain="[('is_active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_webhook" model="ir.actions.act_window">
        <field name="name">Webhooks</field>
        <field name="res_model">greenlight.webhook</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- Webhook Delivery Log (standalone view) -->
    <record id="view_webhook_delivery_form" model="ir.ui.view">
        <field name="name">greenlight.webhook.delivery.form</field>
        <field name="model">greenlight.webhook.delivery</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="webhook_id" readonly="1"/>
                            <field name="event_type" readonly="1"/>
                            <field name="create_date" string="Sent At" readonly="1"/>
                        </group>
                        <group>
                            <field name="response_status" readonly="1"/>
                            <field name="success" readonly="1"/>
                            <field name="duration_ms" readonly="1"/>
                        </group>
                    </group>
                    <group string="Request Payload">
                        <field name="payload" readonly="1" widget="text"/>
                    </group>
                    <group string="Response Body">
                        <field name="response_body" readonly="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_webhook_delivery_list" model="ir.ui.view">
        <field name="name">greenlight.webhook.delivery.list</field>
        <field name="model">greenlight.webhook.delivery</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Sent At"/>
                <field name="webhook_id"/>
                <field name="event_type"/>
                <field name="response_status"/>
                <field name="success"
                       decoration-success="success"
                       decoration-danger="not success"/>
                <field name="duration_ms"/>
            </list>
        </field>
    </record>

    <record id="view_webhook_delivery_search" model="ir.ui.view">
        <field name="name">greenlight.webhook.delivery.search</field>
        <field name="model">greenlight.webhook.delivery</field>
        <field name="arch" type="xml">
            <search>
                <filter string="Successful" name="success" domain="[('success', '=', True)]"/>
                <filter string="Failed" name="failed" domain="[('success', '=', False)]"/><filter string="Webhook" name="group_webhook"
                            context="{'group_by': 'webhook_id'}"/>
                    <filter string="Event Type" name="group_event"
                            context="{'group_by': 'event_type'}"/></search>
        </field>
    </record>

    <record id="action_webhook_delivery" model="ir.actions.act_window">
        <field name="name">Webhook Deliveries</field>
        <field name="res_model">greenlight.webhook.delivery</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
