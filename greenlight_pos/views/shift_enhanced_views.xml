<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Enhanced Shift form: inherit and extend the existing shift form (if any)
         Since there's no existing shift form view, we define a full one. -->

    <record id="view_shift_enhanced_form" model="ir.ui.view">
        <field name="name">greenlight.shift.enhanced.form</field>
        <field name="model">greenlight.shift</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_shift" type="object" string="Open Shift"
                            class="btn-primary"
                            invisible="state != 'open' or clock_in"/>
                    <button name="action_close_shift" type="object" string="Close Shift"
                            class="btn-danger"
                            invisible="state == 'closed'"
                            confirm="Are you sure you want to close this shift?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="employee_id" readonly="state == 'closed'"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Shift Time">
                            <field name="clock_in" readonly="state == 'closed'"/>
                            <field name="clock_out" readonly="1"/>
                            <field name="is_open" invisible="1"/>
                        </group>
                        <group string="Cash Reconciliation">
                            <field name="opening_cash" readonly="state == 'closed'"/>
                            <field name="is_blind_count"/>
                            <field name="closing_cash"
                                   readonly="state == 'closed'"/>
                            <field name="expected_cash"
                                   readonly="1"
                                   invisible="is_blind_count and state != 'closed'"/>
                            <field name="cash_variance" readonly="1"
                                   decoration-danger="cash_variance &lt; 0"
                                   decoration-success="cash_variance == 0"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cash Transactions" name="cash_txns">
                            <field name="cash_transaction_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="create_date"/>
                                    <field name="customer_id"/>
                                    <field name="total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Shift closing notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shift_enhanced_list" model="ir.ui.view">
        <field name="name">greenlight.shift.enhanced.list</field>
        <field name="model">greenlight.shift</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="clock_in"/>
                <field name="clock_out"/>
                <field name="state"/>
                <field name="opening_cash"/>
                <field name="closing_cash"/>
                <field name="expected_cash"/>
                <field name="cash_variance"
                       decoration-danger="cash_variance &lt; 0"
                       decoration-success="cash_variance == 0"/>
            </list>
        </field>
    </record>

    <record id="view_shift_enhanced_search" model="ir.ui.view">
        <field name="name">greenlight.shift.enhanced.search</field>
        <field name="model">greenlight.shift</field>
        <field name="arch" type="xml">
            <search>
                <filter string="Open" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
                <filter string="Has Variance" name="has_variance"
                        domain="[('cash_variance', '!=', 0)]"/><filter string="Employee" name="group_employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/></search>
        </field>
    </record>

    <record id="action_shift_enhanced" model="ir.actions.act_window">
        <field name="name">Shifts</field>
        <field name="res_model">greenlight.shift</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
