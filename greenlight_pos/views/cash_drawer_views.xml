<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cash_drawer_form" model="ir.ui.view">
        <field name="name">greenlight.cash.drawer.form</field>
        <field name="model">greenlight.cash.drawer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="opened_at"/>
                            <field name="closed_at"/>
                        </group>
                        <group>
                            <field name="opening_balance"/>
                            <field name="expected_balance"/>
                            <field name="closing_balance"/>
                            <field name="variance"/>
                        </group>
                    </group>
                    <field name="event_ids">
                        <list>
                            <field name="create_date"/>
                            <field name="event_type"/>
                            <field name="amount"/>
                            <field name="note"/>
                            <field name="transaction_id"/>
                        </list>
                    </field>
                    <field name="notes" placeholder="Closing notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cash_drawer" model="ir.actions.act_window">
        <field name="name">Cash Drawers</field>
        <field name="res_model">greenlight.cash.drawer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
