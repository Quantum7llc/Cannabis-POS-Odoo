<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transaction_form" model="ir.ui.view">
        <field name="name">greenlight.transaction.form</field>
        <field name="model">greenlight.transaction</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_void" type="object" string="Void" invisible="state != 'confirmed'" class="btn-danger"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="customer_id"/>
                            <field name="employee_id"/>
                            <field name="payment_method"/>
                        </group>
                        <group>
                            <field name="subtotal"/>
                            <field name="tax_amount"/>
                            <field name="total"/>
                            <field name="cogs_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Line Items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>
                                    <field name="tax"/>
                                    <field name="cannabis_type"/>
                                    <field name="weight_grams"/>
                                </list>
                            </field>
                        </page>
                        <page string="Metrc" invisible="metrc_sync_status == 'skipped'">
                            <group>
                                <field name="metrc_receipt_id"/>
                                <field name="metrc_sync_status"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_transaction_tree" model="ir.ui.view">
        <field name="name">greenlight.transaction.tree</field>
        <field name="model">greenlight.transaction</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="create_date"/>
                <field name="customer_id"/>
                <field name="employee_id"/>
                <field name="total"/>
                <field name="payment_method"/>
                <field name="state"/>
                <field name="metrc_sync_status"/>
            </list>
        </field>
    </record>

    <record id="action_transaction" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">greenlight.transaction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
