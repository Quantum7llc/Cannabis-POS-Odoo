<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_receipt" model="mail.template">
            <field name="name">Green Light POS: Receipt</field>
            <field name="model_id" ref="greenlight_pos.model_greenlight_receipt"/>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.customer_email }}</field>
            <field name="subject">Your Receipt {{ object.receipt_number }} - {{ object.dispensary_name }}</field>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #1b5e20; color: white; padding: 20px; text-align: center;">
        <h2 style="margin: 0;">{{ object.dispensary_name or 'Green Light Dispensary' }}</h2>
        <p style="margin: 5px 0 0 0; font-size: 12px;">License: {{ object.dispensary_license or '' }}</p>
    </div>
    <div style="padding: 20px; border: 1px solid #e0e0e0;">
        <h3 style="border-bottom: 2px solid #1b5e20; padding-bottom: 8px;">
            Receipt {{ object.receipt_number }}
        </h3>
        <table style="width: 100%; font-size: 14px;">
            <tr>
                <td><strong>Date:</strong></td>
                <td>{{ object.create_date }}</td>
            </tr>
            <tr>
                <td><strong>Customer:</strong></td>
                <td>{{ object.customer_name }}</td>
            </tr>
            <tr>
                <td><strong>Served by:</strong></td>
                <td>{{ object.employee_id.name }}</td>
            </tr>
            <tr>
                <td><strong>Payment:</strong></td>
                <td>{{ object.payment_method }}</td>
            </tr>
        </table>
        <hr style="margin: 15px 0;"/>
        <table style="width: 100%; font-size: 14px;">
            <tr>
                <td>Subtotal:</td>
                <td style="text-align: right;">${{ '%.2f' % object.subtotal }}</td>
            </tr>
            <tr>
                <td>Tax:</td>
                <td style="text-align: right;">${{ '%.2f' % object.tax_amount }}</td>
            </tr>
            <tr style="font-weight: bold; font-size: 16px;">
                <td>Total:</td>
                <td style="text-align: right;">${{ '%.2f' % object.total }}</td>
            </tr>
        </table>
        <hr style="margin: 15px 0;"/>
        <p style="font-size: 12px; color: #666; text-align: center;">
            {{ object.dispensary_address or '' }}<br/>
            Thank you for your visit!
        </p>
    </div>
</div>
            </field>
        </record>
    </data>
</odoo>
