<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19.0: use res.groups.privilege instead of ir.module.category -->
    <record id="res_groups_privilege_greenlight" model="res.groups.privilege">
        <field name="name">Green Light POS</field>
    </record>

    <record id="group_budtender" model="res.groups">
        <field name="name">Budtender</field>
        <field name="privilege_id" ref="res_groups_privilege_greenlight"/>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_greenlight"/>
        <field name="implied_ids" eval="[(4, ref('group_budtender'))]"/>
    </record>

    <record id="group_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="privilege_id" ref="res_groups_privilege_greenlight"/>
        <field name="implied_ids" eval="[(4, ref('group_manager'))]"/>
    </record>
</odoo>
