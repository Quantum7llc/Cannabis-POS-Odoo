<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- QWeb Template: End-of-Day Sales Summary -->
    <template id="report_daily_sales_document">
        <t t-call="web.html_container">
            <t t-foreach="results" t-as="r">
                <t t-set="report" t-value="r['report']"/>
                <t t-set="top_products" t-value="r['top_products']"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .ds-title { text-align: center; margin-bottom: 25px; }
                            .ds-title h2 { margin-bottom: 5px; color: #2c3e50; }
                            .ds-title .date { font-size: 16px; color: #555; }
                            .ds-section { margin-bottom: 20px; }
                            .ds-section h4 { color: #2c3e50; border-bottom: 2px solid #2c3e50; padding-bottom: 5px; margin-bottom: 10px; text-transform: uppercase; font-size: 13px; letter-spacing: 1px; }
                            .ds-grid { display: flex; flex-wrap: wrap; gap: 15px; margin-bottom: 20px; }
                            .ds-card { flex: 1 1 200px; background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 6px; padding: 15px; text-align: center; }
                            .ds-card .value { font-size: 24px; font-weight: bold; color: #2c3e50; }
                            .ds-card .label { font-size: 11px; color: #666; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 5px; }
                            .ds-table { width: 100%; border-collapse: collapse; }
                            .ds-table th { background-color: #2c3e50; color: white; padding: 10px 12px; text-align: left; font-size: 12px; text-transform: uppercase; }
                            .ds-table td { padding: 10px 12px; border-bottom: 1px solid #e0e0e0; }
                            .ds-table .text-right { text-align: right; }
                            .ds-table tr.total-row { background-color: #ecf0f1; font-weight: bold; }
                            .ds-table tr.total-row td { border-top: 2px solid #2c3e50; border-bottom: 2px solid #2c3e50; }
                            .ds-variance-ok { color: #27ae60; }
                            .ds-variance-bad { color: #e74c3c; }
                            .ds-badge { display: inline-block; padding: 3px 10px; border-radius: 3px; font-size: 11px; font-weight: bold; }
                            .ds-badge-draft { background: #ffc107; color: #333; }
                            .ds-badge-confirmed { background: #28a745; color: white; }
                        </style>

                        <!-- Header -->
                        <div class="ds-title">
                            <h2>Daily Sales Report</h2>
                            <div class="date">
                                <span t-field="report.report_date" t-options="{'widget': 'date'}"/>
                            </div>
                            <div style="margin-top: 5px;">
                                Closed by: <strong t-esc="report.employee_id.name"/>
                                <span t-if="report.state == 'draft'" class="ds-badge ds-badge-draft">DRAFT</span>
                                <span t-if="report.state == 'confirmed'" class="ds-badge ds-badge-confirmed">CONFIRMED</span>
                            </div>
                        </div>

                        <!-- Key Metrics Cards -->
                        <div class="ds-grid">
                            <div class="ds-card">
                                <div class="value" t-esc="report.transaction_count"/>
                                <div class="label">Total Transactions</div>
                            </div>
                            <div class="ds-card">
                                <div class="value">
                                    <span t-field="report.gross_sales" t-options="{'widget': 'monetary', 'display_currency': report.currency_id}"/>
                                </div>
                                <div class="label">Gross Sales</div>
                            </div>
                            <div class="ds-card">
                                <div class="value">
                                    <span t-field="report.net_sales" t-options="{'widget': 'monetary', 'display_currency': report.currency_id}"/>
                                </div>
                                <div class="label">Net Sales</div>
                            </div>
                            <div class="ds-card">
                                <div class="value">
                                    <span t-field="report.tax_collected" t-options="{'widget': 'monetary', 'display_currency': report.currency_id}"/>
                                </div>
                                <div class="label">Tax Collected</div>
                            </div>
                        </div>

                        <!-- Revenue by Payment Method -->
                        <div class="ds-section">
                            <h4>Revenue by Payment Method</h4>
                            <table class="ds-table">
                                <thead>
                                    <tr>
                                        <th>Payment Method</th>
                                        <th class="text-right">Total</th>
                                        <th class="text-right">% of Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Cash</td>
                                        <td class="text-right">
                                            <span t-field="report.total_cash" t-options="{'widget': 'monetary', 'display_currency': report.currency_id}"/>
                                        </td>
                                        <td class="text-right">
                                            <t t-if="report.gross_sales">
                                                <span t-esc="'{:.1f}%'.format((report.total_cash or 0) / (report.gross_sales + report.tax_collected) * 100 if (report.gross_sales + report.tax_collected) else 0)"/>
                                            </t>
                                            <t t-else="">0.0%</t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Debit</td>
                                        <td class="text-right">
                                            <span t-field="report.total_debit" t-options="{'widget': 'monetary', 'display_currency': report.currency_id}"/>
                                        </td>
                                        <td class="text-right">
                                            <t t-if="report.gross_sales">
                                                <span t-esc="'{:.1f}%'.format((report.total_debit or 0) / (report.gross_sales + report.tax_collected) * 100 if (report.gross_sales + report.tax_collected) else 0)"/>
                                            </t>
                                            <t t-else="">0.0%</t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Card</td>
                                        <td class="text-right">
                                            <span t-field="report.total_card" t-options="{'widget': 'monetary', 'display_currency': report.currency_id}"/>
                                        </td>
                                        <td class="text-right">
                                            <t t-if="report.gross_sales">
                                                <span t-esc="'{:.1f}%'.format((report.total_card or 0) / (report.gross_sales + report.tax_collected) * 100 if (report.gross_sales + report.tax_collected) else 0)"/>
                                            </t>
                                            <t t-else="">0.0%</t>
                                        </td>
                                    </tr>
                                    <tr class="total-row">
                                        <td>Total Revenue</td>
                                        <td class="text-right">
                                            <span t-esc="'${:,.2f}'.format((report.total_cash or 0) + (report.total_debit or 0) + (report.total_card or 0))"/>
                                        </td>
                                        <td class="text-right">100.0%</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Cash Reconciliation -->
                        <div class="ds-section">
                            <h4>Cash Reconciliation</h4>
                            <table class="ds-table">
                                <tbody>
                                    <tr>
                                        <td style="width: 60%;">Expected Cash in Drawer</td>
                                        <td class="text-right">
                                            <span t-field="report.expected_cash" t-options="{'widget': 'monetary', 'display_currency': report.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Actual Cash Counted</td>
                                        <td class="text-right">
                                            <span t-field="report.actual_cash" t-options="{'widget': 'monetary', 'display_currency': report.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr class="total-row">
                                        <td>Cash Variance</td>
                                        <td class="text-right">
                                            <span t-att-class="'ds-variance-ok' if report.cash_variance == 0 else 'ds-variance-bad'">
                                                <span t-field="report.cash_variance" t-options="{'widget': 'monetary', 'display_currency': report.currency_id}"/>
                                            </span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Voids and Refunds -->
                        <div class="ds-section">
                            <h4>Voids &amp; Refunds</h4>
                            <table class="ds-table">
                                <tbody>
                                    <tr>
                                        <td style="width: 60%;">Voided Transactions</td>
                                        <td class="text-right" t-esc="report.void_count"/>
                                    </tr>
                                    <tr>
                                        <td>Total Refunds</td>
                                        <td class="text-right">
                                            <span t-field="report.refund_total" t-options="{'widget': 'monetary', 'display_currency': report.currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Top 5 Products -->
                        <div class="ds-section">
                            <h4>Top 5 Products by Quantity Sold</h4>
                            <t t-if="top_products">
                                <table class="ds-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 10%;">#</th>
                                            <th>Product</th>
                                            <th class="text-right">Qty Sold</th>
                                            <th class="text-right">Revenue</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="top_products" t-as="prod">
                                            <tr>
                                                <td t-esc="prod_index + 1"/>
                                                <td t-esc="prod['name']"/>
                                                <td class="text-right" t-esc="prod['quantity']"/>
                                                <td class="text-right" t-esc="'${:,.2f}'.format(prod['revenue'])"/>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                            <t t-if="not top_products">
                                <p style="text-align: center; color: #999; padding: 20px;">No transactions recorded for this date.</p>
                            </t>
                        </div>

                        <!-- Notes -->
                        <t t-if="report.notes">
                            <div class="ds-section">
                                <h4>Notes</h4>
                                <p t-esc="report.notes"/>
                            </div>
                        </t>

                        <!-- Report Footer -->
                        <div style="text-align: center; margin-top: 30px; padding-top: 15px; border-top: 1px solid #ccc; font-size: 10px; color: #999;">
                            Report generated on <span t-esc="time.strftime('%Y-%m-%d %H:%M')"/> by <span t-esc="user.name"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
