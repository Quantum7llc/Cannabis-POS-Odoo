<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_metrc_config_form" model="ir.ui.view">
        <field name="name">greenlight.metrc.config.form</field>
        <field name="model">greenlight.metrc.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group string="Facility">
                            <field name="facility_name"/>
                            <field name="facility_license"/>
                            <field name="is_active"/>
                        </group>
                        <group string="API Credentials">
                            <field name="api_key" password="True"/>
                            <field name="user_key" password="True"/>
                            <field name="environment"/>
                            <field name="base_url"/>
                        </group>
                    </group>
                    <group string="Sync Settings">
                        <field name="auto_sync"/>
                        <field name="sync_interval_minutes" invisible="not auto_sync"/>
                        <field name="last_sync_at"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_metrc_config_tree" model="ir.ui.view">
        <field name="name">greenlight.metrc.config.tree</field>
        <field name="model">greenlight.metrc.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="facility_name"/>
                <field name="facility_license"/>
                <field name="environment"/>
                <field name="auto_sync"/>
                <field name="last_sync_at"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="action_metrc_config" model="ir.actions.act_window">
        <field name="name">Metrc Configuration</field>
        <field name="res_model">greenlight.metrc.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
