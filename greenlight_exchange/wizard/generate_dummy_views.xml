<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_generate_dummy_wizard_form" model="ir.ui.view">
        <field name="name">greenlight.exchange.generate.dummy.wizard.form</field>
        <field name="model">greenlight.exchange.generate.dummy.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Dummy Exchange Rates">
                <group>
                    <field name="days"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_generate_dummy_wizard" model="ir.actions.act_window">
        <field name="name">Generate Dummy Rates</field>
        <field name="res_model">greenlight.exchange.generate.dummy.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
