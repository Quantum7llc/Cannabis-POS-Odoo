<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Server action that the cron will call -->
        <record id="action_server_daily_rate" model="ir.actions.server">
            <field name="name">Exchange Rate: Daily Update (Dummy)</field>
            <field name="model_id" ref="model_greenlight_exchange_rate"/>
            <field name="state">code</field>
            <field name="code">model.cron_add_daily_rate()</field>
        </record>

        <!-- Cron job referencing the server action -->
        <record id="cron_daily_exchange_rate" model="ir.cron">
            <field name="cron_name">Exchange Rate: Daily Update (Dummy)</field>
            <field name="ir_actions_server_id" ref="action_server_daily_rate"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
